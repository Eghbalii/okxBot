{
  "id": null,
  "uid": "okxbot-overview",
  "title": "okxBot Overview",
  "description": "Pipeline health, trading activity, and resource usage across the ingestor, paper-trader, and strategy-optimizer services (CLAUDE.md §11.6).",
  "tags": ["okxbot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 100, "type": "row", "title": "Pipeline health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 1,
      "type": "stat",
      "title": "WS connections",
      "description": "okxbot_ws_connected per channel — 1 means connected. Any 0 means a feed is down.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "okxbot_ws_connected", "legendFormat": "{{channel}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "WS reconnects (rate)",
      "description": "Sustained reconnect churn on any channel means an unstable upstream OKX feed.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(okxbot_ws_reconnects_total[5m])", "legendFormat": "{{channel}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingestor events/sec",
      "description": "Ticks and candles received from OKX WS, by instrument.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(okxbot_ingestor_events_total[5m])", "legendFormat": "{{inst_id}} — {{kind}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "id": 101, "type": "row", "title": "Trading activity", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false },

    {
      "id": 10,
      "type": "stat",
      "title": "Open paper orders",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 7 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(okxbot_paper_orders_open)", "legendFormat": "open", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Open paper orders by instrument",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 7 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "okxbot_paper_orders_open", "legendFormat": "{{inst_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Strategy signals/hour (by side)",
      "description": "okxbot_strategy_signals_total — every strategy evaluation including holds. Empty until a strategy has fired at least once.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum by (side) (increase(okxbot_strategy_signals_total[1h]))", "legendFormat": "{{side}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Paper orders opened / closed (rate, 1h)",
      "description": "okxbot_paper_orders_opened_total vs closed_total broken out by close reason (sl/tp/manual/rl_early).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(increase(okxbot_paper_orders_opened_total[1h]))", "legendFormat": "opened", "refId": "A" },
        { "expr": "sum by (reason) (increase(okxbot_paper_orders_closed_total[1h]))", "legendFormat": "closed — {{reason}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cumulative realized PnL (USD)",
      "description": "okxbot_paper_orders_realized_pnl_usd_total, by instrument.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "okxbot_paper_orders_realized_pnl_usd_total", "legendFormat": "{{inst_id}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "id": 102, "type": "row", "title": "Resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Goroutines by service",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "go_goroutines", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memory (resident) by service",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "GC pause duration (p50/p99)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "go_gc_duration_seconds{quantile=\"0.5\"}", "legendFormat": "{{job}} p50", "refId": "A" },
        { "expr": "go_gc_duration_seconds{quantile=\"1\"}", "legendFormat": "{{job}} p99", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "id": 103, "type": "row", "title": "Errors", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }, "collapsed": false },

    {
      "id": 30,
      "type": "logs",
      "title": "Recent error logs (all services)",
      "description": "Loki query {level=\"ERROR\"} — CLAUDE.md §11.7. Non-Go containers (Python, Postgres, Redis, Kafka) won't have a parsed level label; use the Explore tab with |= \"text\" for full-text search across those.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "datasource": "Loki",
      "targets": [
        { "expr": "{level=\"ERROR\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
