{
  "id": null,
  "uid": "okxbot-overview",
  "title": "okxBot Overview",
  "description": "Pipeline health, trading activity, and resource usage across the ingestor, paper-trader, and strategy-optimizer services (CLAUDE.md §11.6).",
  "tags": [
    "okxbot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 90,
      "type": "row",
      "title": "Host resources",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 91,
      "type": "timeseries",
      "title": "CPU usage %",
      "description": "100 - idle%, averaged across all cores (node_cpu_seconds_total).",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 92,
      "type": "timeseries",
      "title": "RAM used / total",
      "description": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes (used), vs total.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        },
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "total",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 93,
      "type": "stat",
      "title": "Free disk space (root)",
      "description": "node_filesystem_avail_bytes for the root filesystem.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "free",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2147483648
              },
              {
                "color": "green",
                "value": 5368709120
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Pipeline health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "WS connections",
      "description": "okxbot_ws_connected per channel — 1 means connected. Any 0 means a feed is down.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "okxbot_ws_connected",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "WS reconnects (rate)",
      "description": "Sustained reconnect churn on any channel means an unstable upstream OKX feed.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "rate(okxbot_ws_reconnects_total[5m])",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingestor events/sec",
      "description": "Ticks and candles received from OKX WS, by instrument.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "rate(okxbot_ingestor_events_total[5m])",
          "legendFormat": "{{inst_id}} — {{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Trading activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Open paper orders",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "sum(okxbot_paper_orders_open)",
          "legendFormat": "open",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Open paper orders by instrument",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 4,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "okxbot_paper_orders_open",
          "legendFormat": "{{inst_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Strategy signals/hour (by side)",
      "description": "okxbot_strategy_signals_total — every strategy evaluation including holds. Empty until a strategy has fired at least once.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (side) (increase(okxbot_strategy_signals_total[1h]))",
          "legendFormat": "{{side}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Paper orders opened / closed (rate, 1h)",
      "description": "okxbot_paper_orders_opened_total vs closed_total broken out by close reason (sl/tp/manual/rl_early).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(okxbot_paper_orders_opened_total[1h]))",
          "legendFormat": "opened",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        },
        {
          "expr": "sum by (reason) (increase(okxbot_paper_orders_closed_total[1h]))",
          "legendFormat": "closed — {{reason}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cumulative realized PnL (USD)",
      "description": "okxbot_paper_orders_realized_pnl_usd_total, by instrument.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "okxbot_paper_orders_realized_pnl_usd_total",
          "legendFormat": "{{inst_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
