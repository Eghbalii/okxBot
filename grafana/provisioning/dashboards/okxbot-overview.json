    {
      "id": 22,
      "type": "timeseries",
      "title": "GC pause duration (p50/p99)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "okxbot-prometheus"
      },
      "targets": [
        {
          "expr": "go_gc_duration_seconds{quantile=\"0.5\"}",
          "legendFormat": "{{job}} p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        },
        {
          "expr": "go_gc_duration_seconds{quantile=\"1\"}",
          "legendFormat": "{{job}} p99",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "okxbot-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "collapsed": false
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Recent error logs (all services)",
      "description": "Loki query {level=\"ERROR\"} — CLAUDE.md §11.7. Non-Go containers (Python, Postgres, Redis, Kafka) won't have a parsed level label; use the Explore tab with |= \"text\" for full-text search across those.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "loki",
        "uid": "okxbot-loki"
      },
      "targets": [
        {
          "expr": "{level=\"ERROR\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "okxbot-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
