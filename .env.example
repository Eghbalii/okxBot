# Copy to .env and fill in. Use OKX DEMO TRADING keys while developing.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED_TRADING=1

REDIS_ADDR=localhost:6379
POSTGRES_DSN=postgres://okxbot:okxbot@localhost:5432/okxbot

RL_SERVICE_URL=http://localhost:8000

# Grafana admin password. Was hardcoded to "admin" in docker-compose.yml while port 3000 was
# reachable from the internet; docker compose now refuses to start without this set.
GRAFANA_ADMIN_PASSWORD=
