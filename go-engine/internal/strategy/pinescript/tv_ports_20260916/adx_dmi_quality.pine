// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/

//@version=6
strategy("DMI/ADX Trend Dashboard v3 (Pullback + Decay)", "DMI-ADX-TQD-v3", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     margin_long=100, margin_short=100)

// groups
gDMI    = "DMI / ADX"
gTrend  = "Trend Filter (EMA)"
gEntry  = "Entry Mode"
gExit   = "Exits & Stops"
gSize   = "Position Sizing"
gScore  = "Trend Score Weights"
gVis    = "Visuals"

// dmi/adx settings
diLen         = input.int(14, "DI Length", group=gDMI)
adxLen        = input.int(14, "ADX Smoothing", group=gDMI)
useADXFilter  = input.bool(true, "Require Min ADX to Trade", group=gDMI)
adxThresh     = input.int(20, "Min ADX Threshold", group=gDMI)
adxExtreme    = input.int(40, "Extreme ADX Level", group=gDMI)
useDISpread   = input.bool(true, "Require Min DI Spread", group=gDMI)
diSpreadMin   = input.float(10.0, "Min DI Spread (|+DI - -DI|)", group=gDMI)

// ema trend filter
useEMAFilter  = input.bool(true, "Enable EMA Trend Filter", group=gTrend)
emaLen        = input.int(50, "Trend EMA Length", group=gTrend)

// entry mode
usePullbackEntry = input.bool(true, "Use Pullback Entries (off = raw DI crossover)", group=gEntry)
emaFastLen        = input.int(9, "Pullback Trigger EMA Length", group=gEntry)

// exits/stops
atrLen           = input.int(14, "ATR Length", group=gExit)
initialStopMult  = input.float(2.0, "Initial Stop ATR Mult (from avg entry price)", group=gExit)
useChandelier    = input.bool(true, "Enable Chandelier Trailing Stop", group=gExit)
chandelierLen    = input.int(22, "Chandelier Lookback (bars)", group=gExit)
chandelierMult   = input.float(3.0, "Chandelier ATR Mult", group=gExit)
useReversalExit  = input.bool(true, "Exit on DI Reversal Cross", group=gExit)
useADXDecayExit  = input.bool(true, "Exit on ADX %% Decay From Peak", group=gExit)
adxDecayPctThresh = input.float(30.0, "ADX Decay Threshold (%% off peak)", group=gExit)
useCooldown      = input.bool(true, "Enable Cooldown After Exit", group=gExit)
cooldownBars     = input.int(5, "Cooldown Bars", group=gExit)

// sizing
riskPct          = input.float(1.0, "Base Risk %% Per Trade", group=gSize)
useQualityScaling = input.bool(true, "Scale Size by Trend Score", group=gSize)
qualityBoost     = input.float(1.5, "High-Quality Size Multiplier", group=gSize)
qualityCut       = input.float(0.5, "Low-Quality Size Multiplier", group=gSize)

// trend score weights
wADX             = input.float(30, "Weight: ADX Level", group=gScore)
useSpreadInScore = input.bool(true, "Include DI Spread in Score", group=gScore)
wSpread          = input.float(20, "Weight: DI Spread", group=gScore)
useADXSlopeScore = input.bool(true, "Include ADX Slope in Score", group=gScore)
wADXSlope        = input.float(25, "Weight: ADX Slope", group=gScore)
useEMASlopeScore = input.bool(true, "Include EMA Slope in Score", group=gScore)
wEMASlope        = input.float(25, "Weight: EMA Slope", group=gScore)
emaSlopeLen      = input.int(5, "EMA Slope Lookback (bars)", group=gScore)
emaSlopeCap      = input.float(2.0, "EMA Slope Normalization Cap (%)", group=gScore)

// visuals
bullColor    = input.color(#00C853, "Bullish Color", group=gVis)
bearColor    = input.color(#FF1744, "Bearish Color", group=gVis)
showGlow     = input.bool(true, "Show Trend Score Glow", group=gVis)
showLabels   = input.bool(true, "Show Buy/Sell Labels", group=gVis)
paintCandles = input.bool(true, "Color Candles by Trend", group=gVis)
showStopLine = input.bool(true, "Show Active Stop Line", group=gVis)
showBG       = input.bool(true, "Show Regime Background", group=gVis)

// core calcs
[diplus, diminus, adx] = ta.dmi(diLen, adxLen)
atrVal   = ta.atr(atrLen)
ema      = ta.ema(close, emaLen)
emaFast  = ta.ema(close, emaFastLen)

diSpread = math.abs(diplus - diminus)
spreadOK = not useDISpread or diSpread > diSpreadMin
adxOK    = not useADXFilter or adx >= adxThresh

// trend direction, used for coloring
var int trendState = 0
trendState := close > ema ? 1 : close < ema ? -1 : trendState
trendColor = trendState == 1 ? bullColor : bearColor

// trend quality score, rescales automatically if a component is turned off
adxComponent      = math.min(adx / adxExtreme, 1.0)
spreadComponent   = math.min(diSpread / 30.0, 1.0)
adxSlope          = adx - adx[3]
adxSlopeComponent = adxSlope > 0 ? math.min(adxSlope / 5.0, 1.0) : 0.0

emaSlopeRaw     = (ema - ema[emaSlopeLen]) / ema[emaSlopeLen] * 100.0
emaSlopeAligned = trendState == 1 ? emaSlopeRaw : trendState == -1 ? -emaSlopeRaw : 0.0
emaSlopeComponent = math.max(math.min(emaSlopeAligned / emaSlopeCap, 1.0), 0.0)

activeWeight = wADX + (useSpreadInScore ? wSpread : 0.0) + (useADXSlopeScore ? wADXSlope : 0.0) + (useEMASlopeScore ? wEMASlope : 0.0)
rawScore = adxComponent * wADX +
     (useSpreadInScore ? spreadComponent * wSpread : 0.0) +
     (useADXSlopeScore ? adxSlopeComponent * wADXSlope : 0.0) +
     (useEMASlopeScore ? emaSlopeComponent * wEMASlope : 0.0)

trendScore = activeWeight > 0 ? (rawScore / activeWeight) * 100.0 : 0.0
qualityTier = trendScore >= 70 ? "High" : trendScore >= 45 ? "Med" : "Low"
sizeMult    = useQualityScaling ? (trendScore >= 70 ? qualityBoost : trendScore >= 45 ? 1.0 : qualityCut) : 1.0

// trend regime check before we even look at entry timing
emaFilterLong  = not useEMAFilter or close > ema
emaFilterShort = not useEMAFilter or close < ema

longRegime  = diplus > diminus and adxOK and spreadOK and emaFilterLong
shortRegime = diminus > diplus and adxOK and spreadOK and emaFilterShort

// cooldown timer
var int lastExitBar = na
cooldownOK = not useCooldown or na(lastExitBar) or (bar_index - lastExitBar) >= cooldownBars

// pullback state — flags a dip below/above fast EMA while regime is active, waits for reclaim
var bool longPullback  = false
var bool shortPullback = false

if longRegime and ta.crossunder(close, emaFast)
    longPullback := true
if not longRegime
    longPullback := false

if shortRegime and ta.crossover(close, emaFast)
    shortPullback := true
if not shortRegime
    shortPullback := false

pullbackLongTrigger  = longPullback and ta.crossover(close, emaFast) and longRegime
pullbackShortTrigger = shortPullback and ta.crossunder(close, emaFast) and shortRegime

crossoverLongTrigger  = ta.crossover(diplus, diminus) and longRegime
crossoverShortTrigger = ta.crossunder(diplus, diminus) and shortRegime

longCondition  = (usePullbackEntry ? pullbackLongTrigger  : crossoverLongTrigger)  and cooldownOK and strategy.position_size <= 0
shortCondition = (usePullbackEntry ? pullbackShortTrigger : crossoverShortTrigger) and cooldownOK and strategy.position_size >= 0

// sizing: risk % of equity / stop distance, adjusted by score
stopDistance = atrVal * initialStopMult
riskAmount   = strategy.equity * (riskPct / 100.0) * sizeMult
qtyToTrade   = stopDistance > 0.0 ? math.max(riskAmount / stopDistance, 0.0) : 0.0

// entries
if longCondition
    strategy.entry("Long", strategy.long, qty=qtyToTrade)
    longPullback := false

if shortCondition
    strategy.entry("Short", strategy.short, qty=qtyToTrade)
    shortPullback := false

// initial stop off avg entry price, then chandelier trail takes over (only tightens in our favor)
newPositionOpened = strategy.position_size != 0 and strategy.position_size[1] == 0

var float entryATR = na
if newPositionOpened
    entryATR := atrVal

var float longStop  = na
var float shortStop = na

if strategy.position_size > 0
    baseStop = strategy.position_avg_price - entryATR * initialStopMult
    if na(longStop[1]) or strategy.position_size[1] <= 0
        longStop := baseStop
    else
        chandLong = ta.highest(high, chandelierLen) - atrVal * chandelierMult
        longStop := useChandelier ? math.max(longStop[1], chandLong) : longStop[1]
else
    longStop := na

if strategy.position_size < 0
    baseStop = strategy.position_avg_price + entryATR * initialStopMult
    if na(shortStop[1]) or strategy.position_size[1] >= 0
        shortStop := baseStop
    else
        chandShort = ta.lowest(low, chandelierLen) + atrVal * chandelierMult
        shortStop := useChandelier ? math.min(shortStop[1], chandShort) : shortStop[1]
else
    shortStop := na

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=longStop)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=shortStop)

// track highest ADX since entry, exit once it decays X% off that peak
var float peakADXSinceEntry = na

if newPositionOpened
    peakADXSinceEntry := adx
else if strategy.position_size != 0
    peakADXSinceEntry := na(peakADXSinceEntry) ? adx : math.max(peakADXSinceEntry, adx)
else
    peakADXSinceEntry := na

adxDecayPct = (strategy.position_size != 0 and not na(peakADXSinceEntry) and peakADXSinceEntry > 0) ?
     (peakADXSinceEntry - adx) / peakADXSinceEntry * 100.0 : 0.0

decayExitCond = useADXDecayExit and strategy.position_size != 0 and adxDecayPct >= adxDecayPctThresh

// exit on reversal or adx decay
if useReversalExit and strategy.position_size > 0 and ta.crossunder(diplus, diminus)
    strategy.close("Long", comment="DI Reversal")

if useReversalExit and strategy.position_size < 0 and ta.crossover(diplus, diminus)
    strategy.close("Short", comment="DI Reversal")

if decayExitCond
    strategy.close_all(comment="ADX Decay")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// log adx at entry, bucket win/loss by adx strength once trade closes
var float[] entryADXLog = array.new_float()
var int lastLoggedTrades = 0

if longCondition or shortCondition
    array.push(entryADXLog, adx)

var int win1 = 0, var int loss1 = 0   // adx 20-25
var int win2 = 0, var int loss2 = 0   // adx 25-35
var int win3 = 0, var int loss3 = 0   // adx 35+

if strategy.closedtrades > lastLoggedTrades
    for i = lastLoggedTrades to strategy.closedtrades - 1
        tradeADX = i < array.size(entryADXLog) ? array.get(entryADXLog, i) : na
        won = strategy.closedtrades.profit(i) > 0
        if not na(tradeADX)
            if tradeADX < 25
                win1 := won ? win1 + 1 : win1
                loss1 := won ? loss1 : loss1 + 1
            else if tradeADX < 35
                win2 := won ? win2 + 1 : win2
                loss2 := won ? loss2 : loss2 + 1
            else
                win3 := won ? win3 + 1 : win3
                loss3 := won ? loss3 : loss3 + 1
    lastLoggedTrades := strategy.closedtrades

winRate(w, l) =>
    t = w + l
    t > 0 ? (w / float(t)) * 100.0 : na

// glow brightness tracks trend score
glowAlpha = int(math.max(35, 90 - trendScore * 0.55))
glowColor = color.new(trendColor, glowAlpha)

plot(showGlow ? ema : na, "Trend Glow Outer", color.new(trendColor, 90), linewidth=8)
plot(showGlow ? ema : na, "Trend Glow Inner", glowColor, linewidth=4)
plot(ema, "Trend Line", trendColor, linewidth=2)

plot(showStopLine and strategy.position_size > 0 ? longStop  : na, "Long Stop",  color.new(bullColor, 20), style=plot.style_linebr)
plot(showStopLine and strategy.position_size < 0 ? shortStop : na, "Short Stop", color.new(bearColor, 20), style=plot.style_linebr)

plotshape(showLabels and longCondition  ? low  : na, "BUY",  shape.labelup,   location.belowbar, bullColor, text="BUY",  textcolor=color.white, size=size.tiny)
plotshape(showLabels and shortCondition ? high : na, "SELL", shape.labeldown, location.abovebar, bearColor, text="SELL", textcolor=color.white, size=size.tiny)

barcolor(paintCandles ? trendColor : na)
bgcolor(showBG ? (not adxOK ? color.new(color.gray, 93) : trendState == 1 ? color.new(bullColor, 94) : color.new(bearColor, 94)) : na)

// dashboard table
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    adxColor    = not adxOK ? color.gray : adx < 25 ? color.yellow : adx < adxExtreme ? color.lime : color.orange
    scoreColor  = color.from_gradient(trendScore, 0, 100, color.red, color.green)
    posText     = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor    = strategy.position_size > 0 ? bullColor : strategy.position_size < 0 ? bearColor : color.gray
    spreadColor = spreadOK ? color.new(color.green, 60) : color.new(color.red, 60)

    table.cell(dash, 0, 0, "DMI/ADX", text_size=size.small, text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(dash, 1, 0, "DASHBOARD", text_size=size.small, text_color=color.white, bgcolor=color.new(color.blue, 30))

    table.cell(dash, 0, 1, "ADX", text_size=size.small, text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(adx, "#.#"), text_size=size.small, bgcolor=adxColor)

    table.cell(dash, 0, 2, "Score", text_size=size.small, text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(trendScore, "#.#") + " " + qualityTier, text_size=size.small, bgcolor=scoreColor)

    table.cell(dash, 0, 3, "DI Spread", text_size=size.small, text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(diSpread, "#.#"), text_size=size.small, bgcolor=spreadColor)

    table.cell(dash, 0, 4, "Position", text_size=size.small, text_color=color.white)
    table.cell(dash, 1, 4, posText, text_size=size.small, bgcolor=color.new(posColor, 40))

    table.cell(dash, 0, 5, "Win% <25/<35/35+", text_size=size.small, text_color=color.white)
    wr1 = winRate(win1, loss1)
    wr2 = winRate(win2, loss2)
    wr3 = winRate(win3, loss3)
    txt = (na(wr1) ? "-" : str.tostring(wr1, "#")) + "/" + (na(wr2) ? "-" : str.tostring(wr2, "#")) + "/" + (na(wr3) ? "-" : str.tostring(wr3, "#"))
    table.cell(dash, 1, 5, txt, text_size=size.small)

// alerts
alertcondition(longCondition, "DMI Long Signal", "DMI/ADX: Bullish entry on {{ticker}} ({{interval}})")
alertcondition(shortCondition, "DMI Short Signal", "DMI/ADX: Bearish entry on {{ticker}} ({{interval}})")