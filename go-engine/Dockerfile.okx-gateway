FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/okx-gateway ./cmd/okx-gateway

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/okx-gateway /app/okx-gateway
WORKDIR /app
ENTRYPOINT ["/app/okx-gateway"]
