FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/strategy-tester ./cmd/strategy-tester

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/strategy-tester /app/strategy-tester
WORKDIR /app
ENTRYPOINT ["/app/strategy-tester"]
