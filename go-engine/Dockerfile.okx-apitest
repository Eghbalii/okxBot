FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/okx-apitest ./cmd/okx-apitest

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/okx-apitest /app/okx-apitest
WORKDIR /app
ENTRYPOINT ["/app/okx-apitest"]
